# T.G.winG 웹 — 환경변수 예시
#
# ⚠️ 로컬 개발은 **비밀키 0개**로 동작합니다 (DECISIONS §17).
#    git clone → npm install → npm run dev 면 끝.
#    dev bypass(가짜 멤버 세션)·로컬 업로드가 기본 동작이라 이 파일을 복사하지 않아도 됩니다.
#    `cp .env.example .env` 해도 실제 키 0개로 로그인된 화면까지 뜹니다.
#
# 아래 값들은 *배포(Vercel·쿠러그)* 또는 DB·인증·스토리지를 실제로 붙일 때만 필요합니다.
# 실제 비밀키는 절대 커밋하지 마세요. 이 .env.example 만 커밋합니다.

# --- 인증 (Auth.js + GitHub OAuth) ---
# 로컬 기본값: dev bypass ON → GitHub OAuth 앱·시크릿 없이 가짜 멤버로 로그인됨.
#   끄려면 아래를 false 로. (프로덕션 빌드에서는 안전을 위해 항상 자동 OFF)
AUTH_DEV_BYPASS=true
# 실제 OAuth 로그인(#14)을 붙일 때만 아래 채움:
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- DB (Postgres) — 스캐폴딩 '중간' 범위 이상에서 사용 ---
# 로컬: docker compose up -d db (#8) 후 아래 주석 해제
# DATABASE_URL=postgresql://user:pass@localhost:5432/tgwing

# --- 파일 저장 (Cloudflare R2, S3 호환) — 스터디 자료 단계에서 ---
# 로컬 기본값: 업로드는 public/uploads/ 에 저장되어 R2 키가 필요 없음.
# 배포에서 실제 R2를 붙일 때만 아래 채움:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
